<% this.title = batch.title + ' - 班级' %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
#back_to_course { display: none;  }
</style>
<% include header %>
<div class="padding">
  <h1><%= batch.title %></h1>
  <div style="margin-bottom: 30px;"><%- batch.subtitle %></div>
  <% let unveiled = (isSupervisior || batch.running || batch.ended); %>
  <% if (batch.start_time && batch.end_time) { %>
    <% let start = syzoj.utils.formatDate(batch.start_time), end = syzoj.utils.formatDate(batch.end_time); %>
    <% if (batch.running && start.split(' ')[0] === end.split(' ')[0]) {
      start = start.split(' ')[1]; end = end.split(' ')[1];
    } %>
    <div class="ui pointing below left label"><%= start %></div>
    <div class="ui pointing below right label"><%= end %></div>
    <% let timePercentage = Math.floor(Math.min(1, (syzoj.utils.getCurrentDate() - batch.start_time) / (batch.end_time - batch.start_time)) * 100); %>
    <div id="timer-progress" class="ui tiny indicating progress<% if (timePercentage == 100) { %> success<% } %>" data-percent="<%= timePercentage %>">
      <div class="bar" style="width: <%= timePercentage %>%;"></div>
    </div>
  <% } %>
  <div class="ui grid">
  <div class="row">
    <div class="column">
      <div class="ui buttons">
        <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id]) %>">课程主页</a>
        <% if (isCourseOwner || user.id === batch.owner_id) { %>
        <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', batch.id, 'edit']) %>">班级设置</a>
        <% } %>
        <% if (isCourseOwner) { %>
        <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', batch.id, 'lesson', 0, 'edit']) %>">新建课节</a>
        <% } %>
      </div>
    </div>
  </div>
  <% if (batch.information) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">班级公告</h4>
        <div class="ui bottom attached segment font-content">
          <%- batch.information %>
        </div>
      </div>
    </div>
  <% } %>
  <% if (unveiled) { %>
    <div class="row">
      <div class="column">
         <table class="ui selectable celled table">
            <thead>
              <tr>
                <th class="one wide" style="text-align: center">#</th>
                <th>课节</th>
                <% if (user) { %>
                  <th class="one wide" style="text-align: center">状态</th>
                <% } %>
                <% if (isCourseOwner) { %>
                  <th class="two wide" style="text-align: center">操作</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <%
              let i = 0;
              for (let lesson of lessons) {
                i++;
              %>
              <tr>
                <td class="center aligned" style="white-space: nowrap; "><b><%= i %></b></td>
                <td><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', batch.id, 'lesson', i]) %>"><%= syzoj.utils.removeTitleTag(lesson.title) %></a></td>
                <% if (user) { %>
                  <td class="center aligned" style="white-space: nowrap; ">TODO</td>
                <% } %>
                <% if (isCourseOwner) { %>
                  <td class="center aligned" style="white-space: nowrap; "><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', batch.id, 'lesson', i, 'edit']) %>">E↑↓×</a></td>
                <% } %>
              </tr>
            <% } %>
            </tbody>
        </table>
      </div>
    </div>
  <% } %>
  </div>
</div>

<script>
$(function () {
  setInterval(function () {
    $('#timer-progress').progress({
      value: Date.now() / 1000 - <%= batch.start_time %>,
      total: <%= batch.end_time - batch.start_time %>
    });
  }, 5000);
});
</script>
<% include footer %>
