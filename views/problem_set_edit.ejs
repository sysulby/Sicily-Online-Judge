<% this.title = set.id ? '题单设置' : '新建题单' %>
<% include header %>
<div class="padding">
  <form action="<%= syzoj.utils.makeUrl(['problems', 'set', set.id, 'edit']) %>" method="post">
    <div class="ui form">
      <div class="field">
        <label>题单名称</label>
        <input type="text" name="title" value="<%= set.title %>">
      </div>
      <div class="field">
        <label>题单简介</label>
        <input type="text" name="subtitle" class="markdown-edit" value="<%= set.subtitle %>">
      </div>
      <div class="field">
        <label>题单负责人</label>
        <select class="ui fluid search dropdown" id="search_owner"<% if (!user.is_admin) { %> disabled<% } %> name="owner">
          <option value="<%= owner.id %>" selected><%= owner.username %></option>
        </select>
      </div>
      <div class="field">
        <label>题单管理员</label>
        <select class="ui fluid search dropdown" multiple="" id="search_admins"<% if (!user.is_admin) { %> disabled<% } %> name="admins">
        <% for (let admin of admins) { %>
          <option value="<%= admin.id %>" selected><%= admin.username %></option>
        <% } %>
        </select>
      </div>
      <div class="inline field">
        <label class="ui header">公开</label>
        <div class="ui toggle checkbox">
          <input type="checkbox"<% if (set.is_public) { %> checked<% } %><% if (!user.is_admin) { %> disabled<% } %> name="is_public">
          <label><span style="visibility: hidden; ">　</span></label>
        </div>
      </div>
      <div style="text-align: center; "><button id="submit_button" type="submit" class="ui labeled icon blue button"><i class="ui edit icon"></i>提交</button></div>
    </div>
  </form>
<script>
$(function () {
  $('#search_owner')
    .dropdown({
      debug: true,
      saveRemoteData: false,
      apiSettings: {
        url: '/api/v2/search/users/{query}',
        cache: false
      }
    });
  $('#search_admins')
    .dropdown({
      debug: true,
      saveRemoteData: false,
      apiSettings: {
        url: '/api/v2/search/users/{query}',
        onResponse: function (response) {
          var a = $('#search_admins').val().map(function (x) { return parseInt(x) });
          if (response.results) {
            response.results = response.results.filter(function(x){ return !a.includes(parseInt(x.value))});
          }
          return response;
        },
        cache: false
      }
    });
});
</script>
<% include footer %>
