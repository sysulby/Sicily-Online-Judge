                <i class="checkmark icon"></i>
                是
              </a>
            </div>
          </div>
          <div class="ui mini basic icon buttons">
            <a class="ui button" onclick="$('#modal-student-resume-<%= i %>').modal('show')"><i class="info icon"></i></a>
            <a class="ui <% if (!student.resume_file) { %>disabled<% } %> button" href="<%= syzoj.utils.makeUrl(['user', student.user.id, 'resume_file'], { class: clazz.id }) %>" target="_blank"><i class="file pdf outline icon"></i>
            <a class="ui button" onclick="$('#modal-student-remove-<%= i %>').modal('show')"><i class="remove icon"></i></a>
          </div>
        </td>
        <% } %>
      </tr>
      <% } %>
    </tbody>
  </table><br>
  <% } else { %>
