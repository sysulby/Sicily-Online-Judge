<% this.title = '学员名单' %>
<% include header %>
<div class="padding">
  <h1><%= clazz.title %></h1>
  <div style="margin-bottom: 30px;"><%- clazz.subtitle %></div>
  <% if (isClassOwner) { %>
    <% if (candidates.length) { %>
    <h2 class="ui header" style="margin-bottom: 30px;">候选人</h2>
    <table class="ui very basic center aligned table">
      <thead>
        <tr>
          <th>用户名</th>
          <th>姓名</th>
          <th>学校</th>
          <th>年级</th>
          <th>校内成绩</th>
          <th>主要奖项</th>
          <th class="two wide">操作</th>
        </tr>
      </thead>
      <tbody>
        <%
        let i = 0;
        for (let candidate of candidates) {
          i++;
        %>
        <tr>
          <td><a href="<%= syzoj.utils.makeUrl(['user', candidate.user.id]) %>"><%= candidate.user.username %></a></td>
          <td><%- candidate.resume.name %></td>
          <td><%- candidate.resume.school %></td>
          <td><%- candidate.resume.grade %></td>
          <td><%- candidate.resume.score %></td>
          <td><%- candidate.resume.award1 %></td>
          <td>
            <div class="ui basic modal" id="modal-candidate-resume-<%= i %>">
              <div class="ui icon header">
                <i class="address card icon"></i>
                <p style="margin-top: 15px; ">学员信息</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>
                  姓名：<%- candidate.resume.name %><br>
                  学校/年级：<%- candidate.resume.school %> / <%- candidate.resume.grade %><br>
                  联系人：<%- candidate.resume.contact %> (<%- candidate.resume.contact_relationship %>) / <%- candidate.resume.phone_number %><br>
                  校内成绩：<%- candidate.resume.score %><br>
                  奖项 1：<%- candidate.resume.award1 %><br>
                  奖项 2：<%- candidate.resume.award2 %><br>
                  奖项 3：<%- candidate.resume.award3 %><br>
                  奖项 4：<%- candidate.resume.award4 %><br>
                </p>
                <p>
                  <% if (!candidate.resume_file) { %>
                  <i class="file pdf outline icon"></i>简历文件：无
                  <% } else { %>
                  <a href="<%= syzoj.utils.makeUrl(['user', candidate.user.id, 'resume_file'], { class: clazz.id }) %>" target="_blank"><i class="file pdf outline icon"></i>简历文件</a>
                  <% } %>
                </p>
              </div>
              <div class="actions">
                <div class="ui green basic cancel inverted button">
                  <i class="checkmark icon"></i>
                  已阅
                </div>
              </div>
            </div>
            <div class="ui basic modal" id="modal-candidate-approval-<%= i %>">
              <div class="ui icon header">
                <i class="checkmark icon"></i>
                <p style="margin-top: 15px; ">通过申请</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>
                  姓名：<%- candidate.resume.name %><br>
                  学校/年级：<%- candidate.resume.school %> / <%- candidate.resume.grade %><br>
                  联系人：<%- candidate.resume.contact %> (<%- candidate.resume.contact_relationship %>) / <%- candidate.resume.phone_number %><br>
                  校内成绩：<%- candidate.resume.score %><br>
                  奖项 1：<%- candidate.resume.award1 %><br>
                  奖项 2：<%- candidate.resume.award2 %><br>
                  奖项 3：<%- candidate.resume.award3 %><br>
                  奖项 4：<%- candidate.resume.award4 %><br>
                </p>
                <p>
                  <% if (!candidate.resume_file) { %>
                  <i class="file pdf outline icon"></i>简历文件：无
                  <% } else { %>
                  <a href="<%= syzoj.utils.makeUrl(['user', candidate.user.id, 'resume_file'], { class: clazz.id }) %>" target="_blank"><i class="file pdf outline icon"></i>简历文件</a>
                  <% } %>
                </p>
                <p>确认通过该申请吗？</p>
              </div>
              <div class="actions">
                <div class="ui red basic cancel inverted button">
                  <i class="remove icon"></i>
                  否
                </div>
                <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'student', candidate.id, 'approval']) %>">
                  <i class="checkmark icon"></i>
                  是
                </a>
              </div>
            </div>
            <div class="ui basic modal" id="modal-candidate-reject-<%= i %>">
              <div class="ui icon header">
                <i class="remove icon"></i>
                <p style="margin-top: 15px; ">驳回申请</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>
                  姓名：<%- candidate.resume.name %><br>
                  学校/年级：<%- candidate.resume.school %> / <%- candidate.resume.grade %><br>
                  联系人：<%- candidate.resume.contact %> (<%- candidate.resume.contact_relationship %>) / <%- candidate.resume.phone_number %><br>
                  校内成绩：<%- candidate.resume.score %><br>
                  奖项 1：<%- candidate.resume.award1 %><br>
                  奖项 2：<%- candidate.resume.award2 %><br>
                  奖项 3：<%- candidate.resume.award3 %><br>
                  奖项 4：<%- candidate.resume.award4 %><br>
                </p>
                <p>
                  <% if (!candidate.resume_file) { %>
                  <i class="file pdf outline icon"></i>简历文件：无
                  <% } else { %>
                  <a href="<%= syzoj.utils.makeUrl(['user', candidate.user.id, 'resume_file'], { class: clazz.id }) %>" target="_blank"><i class="file pdf outline icon"></i>简历文件</a>
                  <% } %>
                </p>
                <p>确认驳回该申请吗？</p>
              </div>
              <div class="actions">
                <div class="ui red basic cancel inverted button">
                  <i class="remove icon"></i>
                  否
                </div>
                <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'student', candidate.id, 'reject']) %>">
                  <i class="checkmark icon"></i>
                  是
                </a>
              </div>
            </div>
            <div class="ui mini basic icon buttons">
              <a class="ui button" onclick="$('#modal-candidate-resume-<%= i %>').modal('show')"><i class="info icon"></i></a>
              <a class="ui <% if (!candidate.resume_file) { %>disabled<% } %> button" href="<%= syzoj.utils.makeUrl(['user', candidate.user.id, 'resume_file'], { class: clazz.id }) %>" target="_blank"><i class="file pdf outline icon"></i>
              <a class="ui button" onclick="$('#modal-candidate-approval-<%= i %>').modal('show')"><i class="checkmark icon"></i></a>
              <a class="ui button" onclick="$('#modal-candidate-reject-<%= i %>').modal('show')"><i class="remove icon"></i></a>
            </div>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table><br>
    <% } else { %>
        <div class="ui placeholder segment">
          <div class="ui icon header">
            <i class="users icon" style="margin-bottom: 20px; "></i>
            暂无候选人
          </div>
        </div>
    <% } %>
  <% } %>
