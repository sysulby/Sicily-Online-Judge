<% this.title = '开班记录 - ' + course.title %>
<% include header %>
<div class="padding">
  <h1><%= course.title %></h1>
  <div style="margin-bottom: 30px;"><%- course.subtitle %></div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id]) %>">返回课程</a>
        </div>
      </div>
    </div>
  </div>
  <h2 class="ui header" style="margin-bottom: 30px;">开班记录</h2>
  <% if (classes.length) { %>
  <% if (isCourseOwner || allowedManageClass) { %>
  <form class="ui mini form" style="margin-top: -30px;">
    <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
      <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'class', 0, 'edit']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
        <i class="ui icon plus"></i>
        新建班级
      </a>
   </div>
  </form>
  <% } %>
  <table class="ui very basic center aligned table">
    <thead>
      <tr>
        <th>课程名称</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>任课教师</th>
        <th>班主任</th>
      </tr>
    </thead>
    <tbody>
      <%
      for (let clazz of classes) {
        let tag = '';
      %>
      <tr>
        <% if (!clazz.is_public) { %>
          <% if (!clazz.teachers.trim()) { %>
            <% if (isCourseOwner) { %>
              <% tag='<span class="ui header"><div class="ui mini yellow label">新申请</div></span>' %>
            <% } else { %>
              <% tag='<span class="ui header"><div class="ui mini disabled yellow label">新申请</div></span>' %>
            <% } %>
          <% } else { %>
            <% if (user.is_admin) { %>
              <% tag='<span class="ui header"><div class="ui mini yellow label">待审核</div></span>' %>
            <% } else { %>
              <% tag='<span class="ui header"><div class="ui mini disabled yellow label">待审核</div></span>' %>
            <% } %>
          <% } %>
        <% } else if (clazz.ended) { %>
          <% tag = '<span class="ui header"><div class="ui mini grey label">已结束</div></span>' %>
        <% } else if (clazz.running) { %>
          <% tag = '<span class="ui header"><div class="ui mini green label">进行中</div></span>' %>
        <% } else { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未开始</div></span>' %>
        <% } %>

        <td><a href="<%= syzoj.utils.makeUrl(['course', clazz.course_id, 'class', clazz.id]) %>"><%= clazz.title %> <%- tag %></a></td>
        <td><%= syzoj.utils.formatDate(clazz.start_time, 'L') %></td>
        <td><%= syzoj.utils.formatDate(clazz.end_time, 'L') %></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', clazz.teacher.id]) %>"><%= clazz.teacher.username %></a></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', clazz.owner.id]) %>"><%= clazz.owner.username %></a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } else { %>
  <div class="ui placeholder segment">
    <div class="ui icon header">
      <i class="book icon" style="margin-bottom: 20px; "></i>
      尚无开班记录
    </div>
    <% if (isCourseOwner || allowedManageClass) { %>
    <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'class', 0, 'edit']) %>" class="ui primary labeled icon button">
      <i class="ui icon plus"></i>
      新建班级
    </a>
    <% } %>
  </div>
  <% } %>
  <br>
  <% include page %>
</div>
<% include footer %>
