<% this.title = '参加考试' %>
<% include header %>
<style>
#back_to_class { display: none;  }
</style>
<div class="padding">
  <h1><%= lesson.title %></h1>
  <div style="margin-bottom: 30px;"><%- lesson.subtitle %></div>
  <div class="ui grid">
    <% if (lesson.reg_info) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">考试须知</h4>
        <div class="ui bottom attached segment font-content">
          <%- lesson.reg_info %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <% if (!reg_open) { %>
        <div class="ui large error message">
          <p>报名将在考试开始前 5 分钟开放，请耐心等待。</p>
        </div>
        <% } else { %>
        <form action="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'register']) %>" method="post" id="lesson_reg">
          <div class="ui form">
            <% if (lesson.reg_info || hasToken) { %>
            <div class="field">
              <label for="token"><% if (hasToken) { %>邀请码<% } else { %>输入 "AGREE" 以继续<% } %></label>
              <input type="text" name="token">
            </div>
            <% } %>
            <div class="ui basic modal" id="modal-confirm">
              <div class="ui icon header">
                <i class="file alternate icon"></i>
                <p style="margin-top: 15px; ">参加考试</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>确认参加该考试吗？</p>
                <b>警告：该操作不可撤销。<% if (lesson.type === 'usaco') { %><br>USACO 赛制将在报名完成后开始计时，<br>测试时长 <%= lesson.duration / 60 %> 分钟。<% } %></b>
              </div>
              <div class="actions">
                <div class="ui red basic cancel inverted button">
                  <i class="remove icon"></i>
                  否
                </div>
                <a class="ui green ok inverted button" id="my_submit">
                  <i class="checkmark icon"></i>
                  是
                </a>
                <script>
                $(function () {
                  $('#my_submit').click(function () {
                    $('#lesson_reg').submit();
                  });
                });
                </script>
              </div>
            </div>
            <div style="text-align: center; margin-top: 30px; ">
              <div class="ui labeled icon blue button" onclick="$('#modal-confirm').modal('show')"><i class="ui edit icon"></i>报名</div>
              <a href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid]) %>" class="ui labeled icon button"><i class="ui angle left icon"></i>返回</a>
            </div>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% include footer %>
