<% this.title = '结课记录' %>
<% include header %>
<div class="padding">
  <h2 class="ui header" style="margin-bottom: 30px;">结课记录</h2>
  <% if (archived_classes.length) { %>
  <form class="ui mini form" style="margin-top: -30px;">
    <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
      <a href="<%= syzoj.utils.makeUrl(['courses']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
        <i class="ui icon arrow left"></i>
        返回课程
      </a>
   </div>
  </form>
  <table class="ui very basic center aligned table">
    <thead>
      <tr>
        <th>班级名称</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>班主任</th>
        <th>任课教师</th>
      </tr>
    </thead>
    <tbody>
      <%
      for (let clazz of archived_classes) {
        let tag = '<span class="ui header"><div class="ui mini grey label">已结束</div></span>';
      %>
      <tr>
        <td><a href="<%= syzoj.utils.makeUrl(['course', clazz.course_id, 'class', clazz.id]) %>"><%= clazz.title %> <%- tag %></a></td>
        <td><%= syzoj.utils.formatDate(clazz.start_time, 'L') %></td>
        <td><%= syzoj.utils.formatDate(clazz.end_time, 'L') %></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', clazz.owner.id]) %>"><%= clazz.owner.username %></a></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', clazz.teacher.id]) %>"><%= clazz.teacher.username %></a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <br>
  <% include page %>
  <% } else { %>
  <div class="ui placeholder segment">
    <div class="ui icon header">
      <i class="book icon" style="margin-bottom: 20px; "></i>
      暂无结课记录
    </div>
    <a href="<%= syzoj.utils.makeUrl(['courses']) %>" class="ui primary labeled icon button">
      <i class="ui icon arrow left"></i>
      返回课程
    </a>
  </div>
  <% } %>
</div>
<% include footer %>
