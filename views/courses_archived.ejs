<% this.title = '归档课程' %>
<% include header %>
<div class="padding">
    <h2 class="ui header">归档课程</h2>
    <% if (archived_courses.length) { %>
    <form class="ui mini form">
      <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
        <a href="<%= syzoj.utils.makeUrl(['courses']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
          <i class="ui icon arrow left"></i>
          返回课程
        </a>
     </div>
    </form>
    <table class="ui very basic center aligned table">
      <thead>
        <tr>
          <th>课程名称</th>
          <th>开始时间</th>
          <th>结束时间</th>
          <th>任课教师</th>
        </tr>
      </thead>
      <tbody>
        <%
        for (let course of archived_courses) {
          let tag = '';
        %>
        <tr>
          <% if (!course.is_public) { %>
            <% tag = '<span class="ui header"><div class="ui mini red label">未公开</div></span>' %>
          <% } else if (course.ended) { %>
            <% tag = '<span class="ui header"><div class="ui mini grey label">已结束</div></span>' %>
          <% } else if (course.running) { %>
            <% tag = '<span class="ui header"><div class="ui mini green label">进行中</div></span>' %>
          <% } else { %>
            <% tag = '<span class="ui header"><div class="ui mini red label">未开始</div></span>' %>
          <% } %>

          <td><a href="<%= syzoj.utils.makeUrl(['course', course.id]) %>"><%= course.title %> <%- tag %></a></td>
          <td><%= syzoj.utils.formatDate(course.start_time, 'L') %></td>
          <td><%= syzoj.utils.formatDate(course.end_time, 'L') %></td>
          <td><a href="<%= syzoj.utils.makeUrl(['user', course.teacher.id]) %>"><%= course.teacher.username %></a></td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } else { %>
    <div class="ui placeholder segment">
      <div class="ui icon header">
        <i class="book icon" style="margin-bottom: 20px; "></i>
        暂无归档课程
      </div>
      <a href="<%= syzoj.utils.makeUrl(['courses']) %>" class="ui primary labeled icon button">
        <i class="ui icon arrow left"></i>
        返回课程
      </a>
    </div>
    <% } %>
  <br>
  <% include page %>
</div>
<% include footer %>
