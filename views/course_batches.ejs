<% this.title = course.title + ' - 课程' %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
#back_to_course { display: none;  }
</style>
<% include header %>
<div class="padding">
  <h1><%= course.title %></h1>
  <div style="margin-bottom: 30px;"><%- course.subtitle %></div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id]) %>">返回课程</a>
        </div>
      </div>
    </div>
  </div>
  <h2 class="ui header">开课记录</h2>
  <% if (batches.length) { %>
  <form class="ui mini form">
    <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
      <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', 0, 'edit']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
        <i class="ui icon plus"></i>
        开课申请
      </a>
   </div>
  </form>
  <table class="ui very basic center aligned table">
    <thead>
      <tr>
        <th>课程名称</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>任课教师</th>
      </tr>
    </thead>
    <tbody>
      <%
      for (let batch of batches) {
        let tag = '';
      %>
      <tr>
        <% if (!batch.is_public) { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未公开</div></span>' %>
        <% } else if (batch.ended) { %>
          <% tag = '<span class="ui header"><div class="ui mini grey label">已结束</div></span>' %>
        <% } else if (batch.running) { %>
          <% tag = '<span class="ui header"><div class="ui mini green label">进行中</div></span>' %>
        <% } else { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未开始</div></span>' %>
        <% } %>

        <td><a href="<%= syzoj.utils.makeUrl(['batch', batch.id]) %>"><%= batch.title %> <%- tag %></a></td>
        <td><%= syzoj.utils.formatDate(batch.start_time, 'L') %></td>
        <td><%= syzoj.utils.formatDate(batch.end_time, 'L') %></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', batch.teacher.id]) %>"><%= batch.teacher.username %></a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } else { %>
  <div class="ui placeholder segment">
    <div class="ui icon header">
      <i class="book icon" style="margin-bottom: 20px; "></i>
      尚无开课记录
    </div>
    <% if (isSupervisior) { %>
    <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'batch', 0, 'edit']) %>" class="ui primary labeled icon button">
      <i class="ui icon plus"></i>
      开课申请
    </a>
    <% } %>
  </div>
  <% } %>
  <br>
  <% include page %>
</div>
<% include footer %>
