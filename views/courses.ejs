<% this.title = '课程' %>
<% include header %>
<% if (has_batch) { %>
<div class="padding">
  <h2 class="ui header">我的课程</h2>
  <% if (active_batches.length) { %>
  <form class="ui mini form">
    <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
      <a href="<%= syzoj.utils.makeUrl(['courses', 'archived']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
        <i class="ui icon archive"></i>
        归档课程
      </a>
   </div>
  </form>
  <table class="ui very basic center aligned table">
    <thead>
      <tr>
        <th>课程名称</th>
        <th>开始时间</th>
        <th>结束时间</th>
        <th>任课教师</th>
      </tr>
    </thead>
    <tbody>
      <%
      for (let batch of active_batches) {
        let tag = '';
      %>
      <tr>
        <% if (!batch.is_public) { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未公开</div></span>' %>
        <% } else if (!batch.running) { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未开始</div></span>' %>
        <% } else { %>
          <% tag = '<span class="ui header"><div class="ui mini green label">进行中</div></span>' %>
        <% } %>
        <td><a href="<%= syzoj.utils.makeUrl(['batch', batch.id]) %>"><%= batch.title %> <%- tag %></a></td>
        <td><%= syzoj.utils.formatDate(batch.start_time, 'L') %></td>
        <td><%= syzoj.utils.formatDate(batch.end_time, 'L') %></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', batch.teacher.id]) %>"><%= batch.teacher.username %></a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <br>
  <div style="margin-bottom: 30px; ">
    <% include page %>
  </div>
  <% } else { %>
  <div class="ui placeholder segment">
    <div class="ui icon header">
      <i class="book icon" style="margin-bottom: 20px; "></i>
      暂无可用课程
    </div>
    <a href="<%= syzoj.utils.makeUrl(['courses', 'archived']) %>" class="ui primary labeled icon button">
      <i class="ui icon archive"></i>
      查看归档课程
    </a>
  </div>
  <% } %>
</div>
<% } %>
<div class="padding">
  <h2 class="ui header">课程体系</h2>
  <% if (courses.length) { %>
  <% if (user && user.is_admin) { %>
  <form class="ui mini form">
    <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
      <a href="<%= syzoj.utils.makeUrl(['course', 0, 'edit']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
        <i class="ui icon plus"></i>
        添加课程
      </a>
   </div>
  </form>
  <% } %>
  <table class="ui very basic center aligned table">
    <thead>
      <tr>
        <th>课程名称</th>
        <th>课程简介</th>
        <th>主管教师</th>
      </tr>
    </thead>
    <tbody>
      <%
      for (let course of courses) {
        let tag = '';
      %>
      <tr>
        <% if (!course.is_public) { %>
          <% tag = '<span class="ui header"><div class="ui mini red label">未公开</div></span>' %>
        <% } %>
        <td><a href="<%= syzoj.utils.makeUrl(['course', course.id]) %>"><%= course.title %> <%- tag %></a></td>
        <td class="font-content"><%- course.subtitle %></td>
        <td><a href="<%= syzoj.utils.makeUrl(['user', course.owner.id]) %>"><%= course.owner.username %></a></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } else { %>
  <div class="ui placeholder segment">
    <div class="ui icon header">
      <i class="book icon" style="margin-bottom: 20px; "></i>
      暂无课程
    </div>
    <% if (user && user.is_admin) { %>
    <a href="<%= syzoj.utils.makeUrl(['course', 0, 'edit']) %>" class="ui primary labeled icon button">
      <i class="ui icon plus"></i>
      添加第一门课程
    </a>
    <% } %>
  </div>
  <% } %>
</div>
<% include footer %>
