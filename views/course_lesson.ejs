<% this.title = contest.title + ' - 课节' %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
</style>
<% include header %>
<%
if (typeof clazz === 'undefined') clazz = null;
%>
<div class="padding">
  <h1><%= contest.title %></h1>
  <div style="margin-bottom: 30px;"><%- contest.subtitle %></div>
  <% const seeResult = (!clazz? isCourseOwner: isSupervisior); %>
  <% const seeRanklist = seeResult || (contest.allowedSeeingResult() && contest.allowedSeeingOthers()); %>
  <% if (clazz && contest.start_time && contest.end_time) { %>
    <% let start = syzoj.utils.formatDate(contest.start_time, 'L'), end = syzoj.utils.formatDate(contest.end_time, 'L'); %>
    <div class="ui pointing below left label"><%= start %></div>
    <div class="ui pointing below right label"><%= end %></div>
    <% let timePercentage = Math.floor(Math.min(1, (syzoj.utils.getCurrentDate() - contest.start_time) / (contest.end_time - contest.start_time)) * 100); %>
    <div id="timer-progress" class="ui tiny indicating progress<% if (timePercentage == 100) { %> success<% } %>" data-percent="<%= timePercentage %>">
      <div class="bar" style="width: <%= timePercentage %>%;"></div>
    </div>
  <% } %>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <% if (!clazz) { %>
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id]) %>">返回课程</a>
          <% } else { %>
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'class', clazz.id]) %>">返回课程</a>
          <% } %>
          <% let submissionsUrl = !clazz ?
            syzoj.utils.makeUrl(['course', course.id, 'submissions'], {lesson: lid}) :
            syzoj.utils.makeUrl(['course', course.id, 'class', clazz.id, 'lesson', lid, 'submissions']); %>
          <a class="ui small positive button" href="<%= submissionsUrl %>">提交记录</a>
        </div>
        <% if (isCourseOwner) { %>
          <div class="ui buttons right floated">
            <% if (!clazz) { %>
            <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', lid, 'edit']) %>">编辑课节</a>
            <% } else { %>
            <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'class', clazz.id, 'lesson', lid, 'edit']) %>">编辑课节</a>
            <% } %>
            <div class="ui basic modal" id="modal-delete-lesson">
              <div class="ui icon header">
                <i class="trash alternate icon"></i>
                <p style="margin-top: 15px; ">删除课节</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>确认删除此课节吗？</p>
              </div>
              <div class="actions">
                <div class="ui red basic cancel inverted button">
                  <i class="remove icon"></i>
                  否
                </div>
                <% if (!clazz) { %>
                <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', lid, 'delete']) %>">
                <% } else { %>
                <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'class', clazz.id, 'lesson', lid, 'delete']) %>">
                <% } %>
                  <i class="checkmark icon"></i>
                  是
                </a>
              </div>
            </div>
            <div class="small ui red button" onclick="$('#modal-delete-lesson').modal('show')">删除课节</div>
          </div>
        <% } %>
      </div>
    </div>
    <% if (contest.information) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">信息与公告</h4>
        <div class="ui bottom attached segment font-content">
          <%- contest.information %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <table class="ui selectable celled table">
          <thead>
            <tr>
              <th class="one wide" style="text-align: center">状态</th>
              <th>题目</th>
              <% if (contest.type === 'ioi') { %>
              <th class="one wide center aligned">统计</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <%
            let i = 0;
            for (let problem of problems) {
              i++;
            %>
            <tr>
              <td class="center aligned" style="white-space: nowrap; ">
              <% if (problem.judge_id) { %>
                <a href="<%= syzoj.utils.makeUrl(['submission', problem.judge_id]) %>">
                  <span class="status <%= problem.status.toLowerCase().split(' ').join('_') %>">
                    <b>
                    <i class="<%= icon[getStatusMeta(problem.status)] || 'remove' %> icon"></i>
                    <%= problem.feedback || problem.status %>
                    </b>
                  </span>
              <% } %>
              </td>
              <td><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', lid, 'problem', i]) %>"><%= syzoj.utils.removeTitleTag(problem.problem.title) %></a></td>
              <% if (contest.type === 'ioi') { %>
              <td class="center aligned" style="white-space: nowrap; ">
              <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'submissions'], { lesson: lid, problem_id: problem.problem.id, status: 'Accepted' }) %>"><%= problem.statistics.accepted %></a>
              /
              <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'submissions'], { lesson: lid, problem_id: problem.problem.id, min_score: 1 }) %>"><%= problem.statistics.partially %></a>
              /
              <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'submissions'], { lesson: lid, problem_id: problem.problem.id }) %>"><%= problem.statistics.attempt %></a>
              </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
$(function () {
  setInterval(function () {
    $('#timer-progress').progress({
      value: Date.now() / 1000 - <%= contest.start_time %>,
      total: <%= contest.end_time - contest.start_time %>
    });
  }, 5000);
});
</script>
<% include footer %>
