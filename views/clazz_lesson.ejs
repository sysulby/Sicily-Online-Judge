<% this.title = lesson.title + ' - 课节' %>
<% include header %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
#back_to_lesson { display: none;  }
</style>
<div class="padding">
  <h1><%= lesson.title %></h1>
  <div style="margin-bottom: 30px;"><%- lesson.subtitle %></div>
  <% const seeRanklist = isSupervisior || lesson.ended || (lesson.allowedSeeingResult() && lesson.allowedSeeingOthers()); %>
  <% let start = syzoj.utils.formatDate(lesson.start_time), end = syzoj.utils.formatDate(lesson.end_time); %>
  <% if (lesson.unveiled && lesson.running && start.split(' ')[0] === end.split(' ')[0]) {
    start = start.split(' ')[1]; end = end.split(' ')[1];
  } %>
  <div class="ui pointing below left label"><%= start %></div>
  <div class="ui pointing below right label"><%= end %></div>
  <% let timePercentage = Math.floor(Math.max(0, Math.min(1, (lesson.end_time - syzoj.utils.getCurrentDate()) / (lesson.end_time - lesson.start_time))) * 100); %>
  <div id="timer-progress" class="ui tiny indicating progress<% if (timePercentage == 0 || timePercentage == 100) { %> disabled<% } %>" dir="rtl" data-percent="<%= timePercentage %>">
    <div class="bar" dir="ltr" style="width: <%= timePercentage %>%;"></div>
  </div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <% if (!isParticipant) { %>
            <% if (lesson.type === 'usaco' || (lesson.reg_token && lesson.reg_token.trim())) { %>
            <a class="ui small primary button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'register']) %>">课节签到</a>
            <% } else { %>
            <a class="ui small primary button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'register']) %>">课节签到</a>
            <% } %>
          <% } else { %>
            <a class="ui small positive disabled button">签到成功</a>
            <a class="ui small button" href="<%= syzoj.utils.makeUrl(['submissions', 'class', clazz.id, 'lesson', lid]) %>">提交记录</a>
          <% } %>
          <% if (seeRanklist) { %>
            <a class="ui small button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'ranklist']) %>">排行榜</a>
          <% } %>
        </div>
        <div class="ui buttons right floated">
          <% if (isMainTeacher) { %>
          <a class="ui small button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'edit']) %>">编辑课节</a>
          <% } %>
          <% if (isCourseOwner) { %>
          <div class="ui basic modal" id="modal-delete-lesson">
            <div class="ui icon header">
              <i class="trash alternate icon"></i>
              <p style="margin-top: 15px; ">删除课节</p>
            </div>
            <div class="content" style="text-align: center; ">
              <p>确认删除此课节吗？</p>
            </div>
            <div class="actions">
              <div class="ui red basic cancel inverted button">
                <i class="remove icon"></i>
                否
              </div>
              <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'delete']) %>">
                <i class="checkmark icon"></i>
                是
              </a>
            </div>
          </div>
          <div class="small ui red button" onclick="$('#modal-delete-lesson').modal('show')">删除课节</div>
          <% } %>
        </div>
      </div>
    </div>
    <% if (lesson.information && isParticipant) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">信息与公告</h4>
        <div class="ui bottom attached segment font-content">
          <%- lesson.information %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <% if (lesson.unveiled) { %>
        <table class="ui selectable celled table">
          <thead>
            <tr>
              <th class="one wide" style="text-align: center">状态</th>
              <th>题目</th>
              <% if (hasStatistics) { %>
                <th class="one wide center aligned">统计</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <%
            let i = 0;
            for (let problem of problems) {
              i++;
            %>
            <tr>
              <td class="center aligned" style="white-space: nowrap; ">
              <% if (problem.judge_id) { %>
                <a href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'submission', problem.judge_id]) %>">
                <% if (typeof problem.status === 'string') { %>
                  <span class="status <%= problem.status.toLowerCase().split(' ').join('_') %>">
                    <b>
                    <i class="<%= icon[getStatusMeta(problem.status)] || 'remove' %> icon"></i>
                    <%= problem.feedback || problem.status %>
                    </b>
                  </span>
                <% } else if (typeof problem.status === 'object') { %>
                  <% if (problem.status.accepted) { %>
                    <span class="score score_10">
                      <% if (problem.status.unacceptedCount === 0) { %>
                        +
                      <% } else { %>
                        +<%= problem.status.unacceptedCount %>
                      <% } %>
                    </span>
                  <% } else { %>
                    <span class="score score_0">
                      <% if (problem.status.unacceptedCount !== 0) { %>
                        -<%= problem.status.unacceptedCount %>
                      <% } %>
                    </span>
                  <% } %>
                <% } %>
              <% } %>
              </td>
              <td>
                <a href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid, 'problem', i]) %>">
                  <%= this.alpha(i) %>.
                  <%= syzoj.utils.removeTitleTag(problem.problem.title) %>
                </a>
              </td>
              <% if (hasStatistics) { %>
                <td class="center aligned" style="white-space: nowrap; ">
                <a href="<%= syzoj.utils.makeUrl(['submissions', 'class', clazz.id, 'lesson', lid], { problem_id: i, status: 'Accepted' }) %>"><%= problem.statistics.accepted %></a>
                /
                  <a href="<%= syzoj.utils.makeUrl(['submissions', 'class', clazz.id, 'lesson', lid], { problem_id: i, min_score: 1 }) %>"><%= problem.statistics.partially %></a>
                  <% if (lesson.type === 'noi' || lesson.type === 'ioi' || lesson.type === 'usaco') { %>
                  /
                <% } %>
                <a href="<%= syzoj.utils.makeUrl(['submissions', 'class', clazz.id, 'lesson', lid], { problem_id: i }) %>"><%= problem.statistics.attempt %></a>
                </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
        <% } else { %>
        <div class="ui placeholder segment">
          <div class="ui icon header">
            <% if (isParticipant) { %>
            <i class="hourglass start icon" style="margin-bottom: 20px; "></i>
            课节尚未开始
            <% } else { %>
            <i class="edit icon" style="margin-bottom: 20px; "></i>
            请先完成签到
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
$(function () {
  setInterval(function () {
    $('#timer-progress').progress({
      value: <%= lesson.end_time %> - Date.now() / 1000,
      total: <%= lesson.end_time - lesson.start_time %>
    });
  }, 5000);
});
</script>
<% include footer %>
