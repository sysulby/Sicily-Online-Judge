<% this.title = clazz.id ? '班级设置' : '新建班级' %>
<% include header %>
<div class="padding">
  <form action="<%= syzoj.utils.makeUrl(['class', clazz.id, 'edit'], { course: course.id }) %>" method="post">
    <div class="ui form">
      <div class="field">
        <label>班级名称</label>
        <input type="text" name="title" value="<%= clazz.title %>">
      </div>
      <div class="two fields">
        <div class="field">
          <label>班级公告</label>
          <textarea rows="5" name="information" class="markdown-edit"><%= clazz.information %></textarea>
        </div>
        <div class="field">
          <label>报名须知</label>
          <textarea rows="5" name="reg_info" class="markdown-edit"><%= clazz.reg_info %></textarea>
        </div>
      </div>
      <div class="five fields">
        <div class="four wide field">
          <label>开课日期</label>
          <input type="text" name="start_time" value="<%= syzoj.utils.formatDate(clazz.start_time || syzoj.utils.getCurrentDate(true) + 3600 * 24 * 15, 'L') %>">
        </div>
        <div class="four wide field">
          <label>结课日期</label>
          <input type="text" name="end_time" value="<%= syzoj.utils.formatDate(clazz.end_time || syzoj.utils.getCurrentDate(true) + 3600 * 24 * 195, 'L') %>">
        </div>
        <div class="four wide field">
          <label>报名开始</label>
          <input type="text" name="reg_start_time" value="<%= syzoj.utils.formatDate(clazz.reg_start_time || syzoj.utils.getCurrentDate(true) + 3600 * 8) %>">
        </div>
        <div class="four wide field">
          <label>报名截止</label>
          <input type="text" name="reg_end_time" value="<%= syzoj.utils.formatDate(clazz.reg_end_time || syzoj.utils.getCurrentDate(true) + 3600 * 24 * 195) %>">
        </div>
      </div>
      <div class="field">
        <label>主教练</label>
        <select class="ui fluid search dropdown" id="search_owner"<% if (!allowedManageClass) { %> disabled<% } %>  name="owner">
          <option value="<%= owner.id %>" selected><%= owner.username %></option>
        </select>
      </div>
      <div class="field">
        <label>教师与助教</label>
        <select class="ui fluid search dropdown" multiple="" id="search_teachers"<% if (!isCourseOwner) { %> disabled<% } %> name="teachers">
        <% for (let teacher of teachers) { %>
          <option value="<%= teacher.id %>" selected><%= teacher.username %></option>
        <% } %>
        </select>
      </div>
      <div class="inline field">
        <label class="ui header">公开</label>
        <div class="ui toggle checkbox">
          <input type="checkbox"<% if (clazz.is_public) { %> checked<% } %><% if (!user.is_admin || !clazz.is_public) { %> disabled<% } %> name="is_public">
          <label><span style="visibility: hidden; ">　</span></label>
        </div>
      </div>
      <div style="text-align: center; "><button id="submit_button" type="submit" class="ui labeled icon blue button"><i class="ui edit icon"></i>提交</button></div>
    </div>
  </form>
<script>
$(function () {
  $('#search_owner')
    .dropdown({
      debug: true,
      saveRemoteData: false,
      apiSettings: {
        url: '/api/v2/search/users/{query}',
        cache: false
      }
    });
  $('#search_teachers')
    .dropdown({
      debug: true,
      saveRemoteData: false,
      apiSettings: {
        url: '/api/v2/search/users/{query}',
        onResponse: function (response) {
          var a = $('#search_teachers').val().map(function (x) { return parseInt(x) });
          if (response.results) {
            response.results = response.results.filter(function(x){ return !a.includes(parseInt(x.value))});
          }
          return response;
        },
        cache: false
      }
    });
});
</script>
<% include footer %>
