<% this.title='课程注册' %>
<% include header %>
<div class="padding">
  <h1><%= course.title %></h1>
  <div style="margin-bottom: 30px;"><%- course.subtitle %></div>
  <div class="ui grid">
    <% if (course.reg_info) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">注意事项</h4>
        <div class="ui bottom attached segment font-content">
          <%- course.reg_info %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <form action="<%= syzoj.utils.makeUrl(['course', course.id, 'register']) %>" method="post">
          <div class="ui form">
            <% if (hasPassword) { %>
            <div class="field">
              <label>比赛密码</label>
              <input type="text" name="password">
            </div>
            <% } %>
            <div style="text-align: center; "><button id="submit_button" type="submit" class="button_blue">报名</button></div>
          </div>
        </form>
      </div>
    </div>
  </div>
<% include footer %>