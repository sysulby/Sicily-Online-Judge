<% include util %>
<!DOCTYPE html>
<html lang="zh-CN" style="position: fixed; width: 100%; overflow: hidden; ">
<head>
    <meta charset="utf-8">
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta name="viewport" content="width=1200">
    <title><%= title %> - <%= syzoj.config.title %></title>
    <link rel="icon" href="/self/favicon.ico">
    <link href="<%- lib('semantic-ui/2.4.1/semantic.min.css') %>" rel="stylesheet">
    <link href="<%- selfLib('syntect-tomorrow.css') %>?20220512" rel="stylesheet">
    <link href="<%- selfLib('style.css') %>?20181212" rel="stylesheet">
    <link href="<%- lib('morris.js/0.5.1/morris.css') %>" rel="stylesheet">
    <% if (useLocalLibs || !syzoj.config.google_fonts || !['like-google-fonts', 'like-local', 'built-in'].includes(syzoj.config.google_fonts.type)) { %>
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'fira-mono.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'lato.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'open-sans.css']) %>" rel="stylesheet">
      <link href="<%- syzoj.utils.makeUrl(['google-fonts', 'exo-2.css']) %>" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'like-local') { %>
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/fira-mono.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/lato.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/open-sans.css" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/google-fonts/exo-2.css" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'like-google-fonts') { %>
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Fira+Mono" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Lato:400,700,400italic,700italic&subset=latin" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i&amp;subset=latin-ext" rel="stylesheet">
      <link href="<%- syzoj.config.google_fonts.url %>/css?family=Exo+2:600" rel="stylesheet">
    <% } else if (syzoj.config.google_fonts.type === 'built-in') { %>
      <link href="<%- this.builtInCdnUrl %>/google-fonts/fira-mono.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/lato.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/open-sans.css" rel="stylesheet">
      <link href="<%- this.builtInCdnUrl %>/google-fonts/exo-2.css" rel="stylesheet">
    <% } %>
    <script data-cfasync="false" src="<%- lib('jquery/3.3.1/jquery.min.js') %>"></script>
    <% if (syzoj.config.google_analytics && syzoj.config.google_analytics !== 'UA-XXXXXXXX-X') { %>
    <script>
      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

      ga('create', '<%= syzoj.config.google_analytics %>', 'auto');
      ga('send', 'pageview');

    </script>
    <% } %>
    <style>
      .ui.block.header {
        background: #fafafa !important;
      }
    </style>
</head>
<body style="position: relative; overflow-y: scroll !important; ">
    <div class="ui top attached borderless menu" style="height: 90px; background-color: #fafafa; ">
        <div class="ui container">
            <%
            if (syzoj.config.logo.url) {
              let width = syzoj.config.logo.width ? syzoj.config.logo.width + 'px' : 'auto';
              let height = syzoj.config.logo.height ? syzoj.config.logo.height + 'px' : 'auto';
            %>
            <a class="header item" href="/"><img src="<%= syzoj.config.logo.url %>" style="width: <%= width %>; height: <%= height %>; "></a>
            <% } else { %>
            <a class="header item" href="/"><span style="font-family: 'Exo 2'; font-size: 2em; font-weight: 600; "><%= syzoj.config.title %></span></a>
            <% } %>
            <% if (active === 'contest') { %>
            <% } else if (active === 'course') { %>
              <% if (typeof course !== 'undefined' && course) { %>
              <div class="item">
                <form action="<%= syzoj.utils.makeUrl(['course', course.id, 'problems']) %>" method="get">
                  <div class="ui search" id="banner_search" style="width: 100%; ">
                    <div class="ui left icon input" style="width: 100%; ">
                      <input class="prompt" style="width: 100%; padding: 0.5em; " type="text" placeholder="ID / 题目名 …" id="search_keyword" name="keyword">
                      <i class="search icon"></i>
                    </div>
                    <div class="results" style="width: 100%; "></div>
                  </div>
                </form>
                <script>
                $(function () {
                  $('#banner_search').search({
                    debug: true,
                    saveRemoteData: false,
                    apiSettings: {
                      url: '/api/v2/search/course/<%= course.id %>/problems/{query}',
                      cache: false
                    },
                    fields: {
                      title: 'name'
                    }
                  });
                });
                </script>
              </div>
              <% } %>
            <% } else if (active === 'class') { %>
            <% } else { %>
            <div class="item">
              <form action="<%= syzoj.utils.makeUrl(['problems']) %>" method="get">
                <input type="hidden" id="search_set" name="set" />
                <div class="ui search" id="banner_search" style="width: 100%; ">
                  <div class="ui left icon input" style="width: 100%; ">
                    <input class="prompt" style="width: 100%; padding: 0.5em; " type="text" placeholder="ID / 题目名 …" id="search_keyword" name="keyword">
                    <i class="search icon"></i>
                  </div>
                  <div class="results" style="width: 100%; "></div>
                </div>
              </form>
              <script>
              let set = localStorage.getItem('set');
              let search_url = !set || set.trim() || set === '0' ? '/api/v2/search/problems/{query}' : '/api/v2/search/set/' + localStorage.getItem('set') + '/problems/{query}';
              $(function () {
                $('#search_set').val(localStorage.getItem('set'));
                $('#banner_search').search({
                  debug: true,
                  saveRemoteData: false,
                  apiSettings: {
                    url: search_url,
                    cache: false
                  },
                  fields: {
                    title: 'name'
                  }
                });
              });
              </script>
            </div>
            <% } %>
            <div class="right menu">
              <% if (user) { %>
              <a href="<%= syzoj.utils.makeUrl(['user', user.id]) %>" style="color: #0000ff; font-size: 1.5rem; ">
              <div class="ui simple dropdown item">
                <img class="ui avatar image" src="<%= syzoj.utils.gravatar(user.email, 1000) %>">
                <%= user.username %><% if (user.nameplate) { %><%- user.nameplate %><% } %>
                <div class="menu">
                  <a class="item" href="<%= syzoj.utils.makeUrl(['user', user.id, 'edit']) %>"><i class="edit icon"></i>修改资料</a>
                  <a class="item" href-post="<%= syzoj.utils.makeUrl(['logout'], { url: req.originalUrl }) %>"><i class="power icon"></i>注销</a>
                </div>
              </div>
              </a>
                <% } else { %>
                <div class="item">
                    <a class="ui button" style="margin-right: 0.5em; " href="<%= syzoj.utils.makeUrl(['login'], { url: req.query['url'] || req.originalUrl }) %>">
                        登录
                    </a>
                    <a class="ui primary button" href="<%= syzoj.utils.makeUrl(['sign_up'], { url: req.query['url'] || req.originalUrl }) %>">
                        注册
                    </a>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <div class="ui bottom attached borderless inverted menu" style="height: 45px; background-color: #337dd4; ">
        <div class="ui container">
            <a class="header item" href="/" style="color: white; "><i class="home icon"></i> 首页</a>
            <a class="header item" href="/problems" onclick="location.href=this.href+'?set='+localStorage.getItem('set');return false;" style="color: white; "><i class="list icon"></i> 题库</a>
            <a class="header item" href="/contests" style="color: white; "><i class="trophy icon"></i> 比赛</a>
            <a class="header item" href="/courses" style="color: white; "><i class="book icon"></i> 课程</a>
            <a class="header item" href="/submissions" style="color: white; "><i class="tasks icon"></i> 评测</a>
            <a class="header item" href="/ranklist" style="color: white; "><i class="signal icon"></i> 排名</a>
            <a class="header item" href="/discussion/global" style="color: white; "><i class="comments icon"></i> 讨论</a>
            <% if (typeof contest !== 'undefined' && contest && contest.id) { %>
              <a id="back_to_contest" class="header item" href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>" style="color: white; "><i class="arrow left icon"></i> 返回比赛</a>
            <% } %>
            <% if (typeof course !== 'undefined' && course && course.id) { %>
              <% if (typeof clazz !== 'undefined' && clazz && clazz.id) { %>
                <% if (typeof lesson !== 'undefined' && lesson && lesson.id && lid) { %>
                <a id="back_to_lesson" class="header item" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', lid]) %>" style="color: white; "><i class="arrow left icon"></i> 返回课节</a>
                <% } %>
                <a id="back_to_class" class="header item" href="<%= syzoj.utils.makeUrl(['class', clazz.id]) %>" style="color: white; "><i class="arrow left icon"></i> 返回班级</a>
              <% } else { %>
              <a id="back_to_course" class="header item" href="<%= syzoj.utils.makeUrl(['course', course.id]) %>" style="color: white; "><i class="arrow left icon"></i> 返回课程</a>
              <% } %>
            <% } %>
            <% if (user) { %>
            <div class="right menu">
              <% if (user.is_admin || user.email.substring(user.email.indexOf('@') + 1) === syzoj.config.domain) { %>
                <% include reg_token %>
                <a class="header item" href="#" style="color: white; " onclick="reg_token();return false;"><i class="paper plane icon"></i> 获取邀请码</a>
              <% } %>
              <% if (user.is_admin) { %>
              <div class="ui simple dropdown item" style="color: white; ">
                <i class="settings icon"></i> <b>网站管理</b> <i class="dropdown icon"></i>
                <div class="menu">
                  <a class="item" href="<%= syzoj.utils.makeUrl(['admin', 'info']) %>"><i class="terminal icon"></i>后台管理</a>
                  <div class="ui basic modal" id="modal-restart">
                    <div class="ui icon header">
                      <i class="redo icon"></i>
                      <p style="margin-top: 15px; ">重启服务</p>
                    </div>
                    <div class="content" style="text-align: center; ">
                      <p>确认重新启动 SYZOJ Web 服务吗？</p>
                    </div>
                    <div class="actions">
                      <div class="ui red basic cancel inverted button">
                        <i class="remove icon"></i>
                        否
                      </div>
                      <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['admin', 'restart'], { url: req.query['url'] || req.originalUrl }) %>">
                        <i class="checkmark icon"></i>
                        是
                      </a>
                    </div>
                  </div>
                  <a class="item" href="#" onclick="$('#modal-restart').modal('show')"><i class="redo icon"></i>重启服务</a>
                </div>
              </div>
              <% } %>
            </div>
            <% } %>
        </div>
    </div>
    <div style="margin-top: 28px; ">
    <div class="ui main container">
