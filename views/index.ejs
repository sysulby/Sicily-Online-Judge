<% this.title = '首页'; %>
<% include header %>
<div class="padding">
  <div class="ui three column grid">
    <div class="five wide column">
      <h4 class="ui top attached block header"><i class="ui calendar icon"></i>近期活动</h4>
      <div class="ui bottom attached segment">
        <% if (notices && notices.length) { %>
        <table class="ui very basic center aligned table">
          <thead>
            <tr>
              <th>公告</th>
              <th class="five wide">发布日期</th>
            </tr>
          </thead>
          <tbody>
            <% for (let item of notices) { %>
                <tr>
                    <td class="left aligned"><a href="<%= item.url %>"><%= item.title %></a></td>
                    <td><%= item.date %></td>
                </tr>
            <% } %>
          </tbody>
        </table>
        <% } %>
        <% if (contests && contests.length) { %>
        <table class="ui very basic center aligned table">
          <thead>
            <tr>
              <th>比赛</th>
              <th class="five wide">开始时间</th>
            </tr>
          </thead>
          <tbody>
            <%
            for (let contest of contests) {
              let now = syzoj.utils.getCurrentDate();
              let tag = '';
            %>
            <tr>
              <% if (contest.start_time && now < contest.start_time) { %>
                <% tag = '<span class="ui header"><div class="ui mini red label">未开始</div></span>' %>
              <% } else if (contest.end_time && now >= contest.end_time) { %>
                <% tag = '<span class="ui header"><div class="ui mini grey label">已结束</div></span>' %>
              <% } else { %>
                <% tag = '<span class="ui header"><div class="ui mini green label">进行中</div></span>' %>
              <% } %>
              <td class="left aligned"><a href="<%= syzoj.utils.makeUrl(['contest', contest.id]) %>"><%= contest.title %> <%- tag %></a></td>
              <td><%= contest.start_time ? syzoj.utils.formatDate(contest.start_time) : 'Whenever' %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
        <% } %>
      </div>
      <h4 class="ui top attached block header"><i class="ui signal icon"></i>排名</h4>
      <div class="ui bottom attached segment">
        <table class="ui very basic center aligned table">
          <thead>
            <tr>
	            <th style="width: 50px; ">#</th>
	            <th style="width: 170px; ">用户名</th>
	            <th>通过数量</th>
            </tr>
          </thead>
          <tbody>
            <%
            let i = 0;
            for (let user of ranklist) {
              ++i;
            %>
                <tr>
                    <td><b><%= i %></b></td>
                    <td><a href="<%= syzoj.utils.makeUrl(['user', user.id]) %>"><%= user.username %></a><% if (user.nameplate) { %><%- user.nameplate %><% } %></td>
                    <td><%= user.ac_num %></td>
                </tr>
             <%
            } %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="eleven wide column">
      <img class="ui fluid image" src="/self/logo.jpg">
    </div>
  </div>
</div>
<script>
$(function () {
  $('#search_users').search({
    debug: true,
    saveRemoteData: false,
    apiSettings: {
      url: '/api/v2/search/users/{query}',
      cache: false
    },
    fields: {
      title: 'name'
    }
  });

  $("body").append(`
      <div id="sicily_chan">
          <div id="talkbox">
              <div id="boxtop"></div>
              <div id="boxcnt">
                  <div>我常常追忆过去。</div>
                  <div>我该在哪里停留？我问我自己。</div>
              </div>
              <div id="boxbottom"></div>
          </div>
          <div id="sicilychan_body">
              <div id="face" class="face1"></div>
          </div>
      </div>
  `);

  $("#sicily_chan").draggable();

  var p;
  (p = () => new Promise((resolve) => {
      setTimeout(() => {
          $("#face").removeClass("face1").addClass("face2");
          resolve();
      }, 2000 + Math.random() * 2000);
  }).then(() => new Promise((resolve) => {
      setTimeout(() => {
          $("#face").removeClass("face2").addClass("face3");
          resolve();
      }, 100);
  })).then(() => new Promise((resolve) => {
      setTimeout(() => {
          $("#face").removeClass("face3").addClass("face1");
          resolve();
      }, 100);
  }).then(p)))();
});
</script>
<% include footer %>
