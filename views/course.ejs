<% this.title = course.title + ' - 课程' %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
#back_to_course { display: none;  }
</style>
<% include header %>
<div class="padding">
  <h1><%= course.title %></h1>
  <div style="margin-bottom: 30px;"><%- course.subtitle %></div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <% if (isSupervisior) { %>
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'classes']) %>">开班记录</a>
          <a class="ui small green button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'problems']) %>">课程题库</a>
          <% } else { %>
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'classes']) %>">报名选课</a>
          <% } %>
          <% if (hasOwnership) { %>
          <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'edit']) %>">课程设置</a>
          <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', 0, 'edit']) %>">新建课节</a>
          <% } %>
        </div>
      </div>
    </div>
    <% if (course.information) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">课程介绍</h4>
        <div class="ui bottom attached segment font-content">
          <%- course.information %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <table class="ui selectable celled table">
          <thead>
            <tr>
              <th class="one wide" style="text-align: center">#</th>
              <th>课节</th>
              <% if (isSupervisior) { %>
              <th class="one wide" style="text-align: center">进度</th>
              <% } %>
              <% if (hasOwnership) { %>
              <th class="two wide" style="text-align: center">操作</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <%
            let i = 0;
            for (let lesson of lessons) {
              i++;
            %>
            <tr>
              <td class="center aligned" style="white-space: nowrap; "><b><%= i %></b></td>
              <% if (isSupervisior) { %>
              <td><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i]) %>"><%= syzoj.utils.removeTitleTag(lesson.title) %></a></td>
              <td class="center aligned" style="white-space: nowrap; ">TODO</td>
              <% } else { %>
              <td><%= syzoj.utils.removeTitleTag(lesson.title) %></td>
              <% } %>
              <% if (hasOwnership) { %>
              <td class="center aligned" style="white-space: nowrap; "><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i, 'edit']) %>">E↑↓×</a></td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<% include footer %>
