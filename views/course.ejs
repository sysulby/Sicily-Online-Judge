<% this.title = course.title + ' - 课程' %>
<% include header %>
<div class="padding">
  <h1><%= course.title %></h1>
  <div style="margin-bottom: 30px;"><%- course.subtitle %></div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <div class="ui buttons">
          <% let entranceInfo = (isSupervisior || allowedManageClass? '开班记录': '报名选班'); %>
          <a class="ui small blue button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'classes']) %>"><%- entranceInfo %></a>
          <% if (isSupervisior) { %>
          <a class="ui small green button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'problems']) %>">课程题库</a>
          <% } %>
        </div>
        <div class="ui buttons right floated">
          <% if (hasOwnership) { %>
          <a class="ui small button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'edit']) %>">课程设置</a>
          <% } %>
          <% if (user && user.is_admin) { %>
          <div class="ui basic modal" id="modal-delete-course">
            <div class="ui icon header">
              <i class="trash icon"></i>
              <p style="margin-top: 15px; ">删除课程</p>
            </div>
            <div class="content" style="text-align: center; ">
              <p>确认删除此课程吗？</p>
              <b>警告：与此课程相关的班级将无法访问。</b>
            </div>
            <div class="actions">
              <div class="ui red basic cancel inverted button">
                <i class="remove icon"></i>
                否
              </div>
              <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'delete']) %>">
                <i class="checkmark icon"></i>
                是
              </a>
            </div>
          </div>
          <div class="small ui red button" onclick="$('#modal-delete-course').modal('show')">删除课程</div>
          <% } %>
        </div>
      </div>
    </div>
    <% if (course.information) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">课程介绍</h4>
        <div class="ui bottom attached segment font-content">
          <%- course.information %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <h2 class="ui header" style="margin-bottom: 30px;">课节列表</h2>
        <% if (hasOwnership) { %>
        <form class="ui mini form" style="margin-top: -30px;">
          <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
            <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', 0, 'edit']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
              <i class="ui icon plus"></i>
              新建课节
            </a>
         </div>
        </form>
        <% } %>
        <table class="ui very basic table">
          <thead>
            <tr>
              <th class="one wide" style="text-align: center">#</th>
              <th>课节</th>
              <% if (user) { %>
              <th class="two wide" style="text-align: center">状态</th>
              <% } %>
              <% if (hasOwnership) { %>
              <th class="two wide" style="text-align: center">操作</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <%
            let i = 0;
            for (let lesson of lessons) {
              i++;
            %>
            <tr>
              <td class="center aligned" style="white-space: nowrap; "><b><%= i %></b></td>
              <% if (isSupervisior) { %>
              <td><a href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i]) %>"><%= syzoj.utils.removeTitleTag(lesson.title) %></a></td>
              <% } else { %>
              <td><%= syzoj.utils.removeTitleTag(lesson.title) %></td>
              <% } %>
              <% if (user) { %>
              <td class="center aligned" style="white-space: nowrap; ">TODO</td>
              <% } %>
              <% if (hasOwnership) { %>
              <td class="center aligned" style="white-space: nowrap; ">
                <div class="ui basic modal" id="modal-delete-lesson">
                  <div class="ui icon header">
                    <i class="trash alternate icon"></i>
                    <p style="margin-top: 15px; ">删除课节</p>
                  </div>
                  <div class="content" style="text-align: center; ">
                    <p>确认删除此课节吗？</p>
                  </div>
                  <div class="actions">
                    <div class="ui red basic cancel inverted button">
                      <i class="remove icon"></i>
                      否
                    </div>
                    <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i, 'delete']) %>">
                      <i class="checkmark icon"></i>
                      是
                    </a>
                  </div>
                </div>
                <div class="ui mini basic icon buttons">
                  <a class="ui button" href="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i, 'edit']) %>"><i class="edit icon"></i></a>
                  <% if (i == 1) { %>
                  <a class="ui disabled button"><i class="arrow up icon"></i></button>
                  <% } else { %>
                  <a class="ui button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i, 'move_up']) %>"><i class="arrow up icon"></i></a>
                  <% } %>
                  <% if (i == lessons.length) { %>
                  <a class="ui disabled button"><i class="arrow down icon"></i></button>
                  <% } else { %>
                  <a class="ui button" href-post="<%= syzoj.utils.makeUrl(['course', course.id, 'lesson', i, 'move_down']) %>"><i class="arrow down icon"></i></a>
                  <% } %>
                  <a class="ui button" onclick="$('#modal-delete-lesson').modal('show')"><i class="trash alternate icon"></i></a>
                </div>
              </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<% include footer %>
