<% this.title = clazz.title + ' - 班级' %>
<% include header %>
<style>
.ui.label.pointing.below.left::before { left: 12%; }
.ui.label.pointing.below.right::before { left: 88%; }
.ui.label.pointing.below.left { margin-bottom: 0; }
.ui.label.pointing.below.right { margin-bottom: 0; float: right; }
#back_to_class { display: none;  }
</style>
<div class="padding">
  <h1><%= clazz.title %></h1>
  <div style="margin-bottom: 30px;"><%- clazz.subtitle %></div>
  <% let unveiled = (isSupervisior || clazz.running || clazz.ended); %>
  <% let start = syzoj.utils.formatDate(clazz.start_time, 'L'), end = syzoj.utils.formatDate(clazz.end_time, 'L'); %>
  <div class="ui pointing below left label"><%= start %></div>
  <div class="ui pointing below right label"><%= end %></div>
  <% let timePercentage = Math.floor(Math.max(0, Math.min(1, (clazz.end_time - syzoj.utils.getCurrentDate()) / (clazz.end_time - clazz.start_time))) * 100); %>
  <div id="timer-progress" class="ui tiny indicating progress<% if (timePercentage == 0 || timePercentage == 100) { %> disabled<% } %>" dir="rtl" data-percent="<%= timePercentage %>">
    <div class="bar" dir="ltr" style="width: <%= timePercentage %>%;"></div>
  </div>
  <div class="ui grid">
    <div class="row">
      <div class="column">
        <% if (isSupervisior) { %>
        <div class="ui buttons">
          <a class="ui small primary button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'students']) %>">学员名单</a>
          <% if (isMainTeacher) { %>
            <a class="ui small button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'files']) %>">课程资料</a>
          <% } %>
        </div>
        <% } %>
        <div class="ui buttons right floated">
          <% if (isClassOwner) { %>
          <a class="ui small <% if (isCourseOwner && !clazz.public && !clazz.teachers.trim()) { %>yellow<% } %> button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'edit']) %>">班级设置</a>
          <% } %>
          <% if (user.is_admin && !clazz.is_public && clazz.teachers.trim()) { %>
          <div class="ui basic modal" id="modal-approval-clazz">
            <div class="ui icon header">
              <i class="exclamation circle icon"></i>
              <p style="margin-top: 15px; ">开班确认</p>
            </div>
            <div class="content" style="text-align: center; ">
              <p>确认通过此开班申请吗？</p>
            </div>
            <div class="actions">
              <div class="ui red basic cancel inverted button">
                <i class="remove icon"></i>
                否
              </div>
              <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'approval']) %>">
                <i class="checkmark icon"></i>
                是
              </a>
            </div>
          </div>
          <div class="small ui yellow button" onclick="$('#modal-approval-clazz').modal('show')">开班确认</div>
          <% } %>
          <% if (user.is_admin) { %>
          <div class="ui basic modal" id="modal-delete-clazz">
            <div class="ui icon header">
              <i class="trash icon"></i>
              <p style="margin-top: 15px; ">删除班级</p>
            </div>
            <div class="content" style="text-align: center; ">
              <p>确认删除此班级吗？</p>
            </div>
            <div class="actions">
              <div class="ui red basic cancel inverted button">
                <i class="remove icon"></i>
                否
              </div>
              <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'delete']) %>">
                <i class="checkmark icon"></i>
                是
              </a>
            </div>
          </div>
          <div class="small ui red button" onclick="$('#modal-delete-clazz').modal('show')">删除班级</div>
          <% } %>
        </div>
      </div>
    </div>
    <% if (clazz.information) { %>
      <div class="row">
        <div class="column">
          <h4 class="ui top attached block header">班级公告</h4>
          <div class="ui bottom attached segment font-content">
            <%- clazz.information %>
          </div>
        </div>
      </div>
    <% } %>
    <% if (unveiled) { %>
      <div class="row">
        <div class="column">
          <h2 class="ui header" style="margin-bottom: 30px;">课节列表</h2>
          <% if (isCourseOwner) { %>
          <form class="ui mini form" style="margin-top: -30px;">
            <div class="inline fields" style="margin-bottom: 25px; white-space: nowrap; ">
              <a <% if (!clazz.is_public) { %>disabled<% } %> href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', 0, 'import']) %>" class="ui mini labeled icon right floated button" style="margin-left: auto; ">
                <i class="ui icon cloud download"></i>
                导入课节
              </a>
           </div>
          </form>
          <% } %>
          <table class="ui very basic center aligned table">
            <thead>
              <tr>
                <th class="one wide">状态</th>
                <th class="one wide">#</th>
                <th class="left aligned">课节</th>
                <th class="three wide">开始时间</th>
                <th class="three wide">结束时间</th>
                <% if (isSupervisior) { %>
                <th class="two wide">操作</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <%
              let i = 0;
              for (let lesson of lessons) {
                i++;
                let tag = '';
                if (lesson.is_public || isSupervisior) {
              %>
              <tr>
                <td></td>
                <td><b><%= i %></b></td>
                <% if (!lesson.is_public) { %>
                  <% tag = '<span class="ui header"><div class="ui mini red label">未公开</div></span>' %>
                <% } %>
                <td class="left aligned"><a href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i]) %>"><%= syzoj.utils.removeTitleTag(lesson.title) %> <%- tag %></a></td>
                <td><%= syzoj.utils.formatDate(lesson.start_time) %></td>
                <td><%= syzoj.utils.formatDate(lesson.end_time) %></td>
                <% if (isSupervisior) { %>
                <td>
                  <div class="ui basic modal" id="modal-public-lesson-<%= i %>">
                    <div class="ui icon header">
                      <i class="trash alternate icon"></i>
                      <p style="margin-top: 15px; ">公开课节</p>
                    </div>
                    <div class="content" style="text-align: center; ">
                      <p>确认公开此课节吗？</p>
                    </div>
                    <div class="actions">
                      <div class="ui red basic cancel inverted button">
                        <i class="remove icon"></i>
                        否
                      </div>
                      <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i, 'public']) %>">
                        <i class="checkmark icon"></i>
                        是
                      </a>
                    </div>
                  </div>
                  <div class="ui basic modal" id="modal-delete-lesson-<%= i %>">
                    <div class="ui icon header">
                      <i class="trash alternate icon"></i>
                      <p style="margin-top: 15px; ">删除课节</p>
                    </div>
                    <div class="content" style="text-align: center; ">
                      <p>确认删除此课节吗？</p>
                    </div>
                    <div class="actions">
                      <div class="ui red basic cancel inverted button">
                        <i class="remove icon"></i>
                        否
                      </div>
                      <a class="ui green ok inverted button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i, 'delete']) %>">
                        <i class="checkmark icon"></i>
                        是
                      </a>
                    </div>
                  </div>
                  <% if (isMainTeacher) { %>
                  <div class="ui mini basic icon buttons">
                    <a class="ui <% if (lesson.is_public) { %>disabled<% } %> button" onclick="$('#modal-public-lesson-' + <%= i %>).modal('show')"><i class="checkmark icon"></i></a>
                    <a class="ui button" href="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i, 'edit']) %>"><i class="edit icon"></i></a>
                    <% if (isCourseOwner) { %>
                    <a class="ui <% if (i == 1) { %>disabled<% } %> button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i, 'move_up']) %>"><i class="arrow up icon"></i></a>
                    <a class="ui <% if (i == lessons.length) { %>disabled<% } %> button" href-post="<%= syzoj.utils.makeUrl(['class', clazz.id, 'lesson', i, 'move_down']) %>"><i class="arrow down icon"></i></a>
                    <a class="ui button" onclick="$('#modal-delete-lesson-' + <%= i %>).modal('show')"><i class="trash alternate icon"></i></a>
                    <% } %>
                  </div>
                  <% } else if (isSupervisior) { %>
                  <a class="ui mini <% if (!lesson.reg_token) { %>disabled<% } %> button" onclick="alert('邀请码：'+<%= lesson.reg_token %>);">查看邀请码</a>
                  <% } %>
                </td>
                <% } %>
              </tr>
            <%
              }
            }
            %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
$(function () {
  setInterval(function () {
    $('#timer-progress').progress({
      value: <%= clazz.end_time %> - Date.now() / 1000,
      total: <%= clazz.end_time - clazz.start_time %>
    });
  }, 5000);
});
</script>
<% include footer %>
