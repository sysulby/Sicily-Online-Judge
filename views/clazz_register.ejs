<% this.title = '报名选课' %>
<% include header %>
<style>
#back_to_class { display: none;  }
</style>
<div class="padding">
  <h1><%= clazz.title %></h1>
  <div style="margin-bottom: 30px;"><%- clazz.subtitle %></div>
  <div class="ui grid">
    <% if (clazz.reg_info) { %>
    <div class="row">
      <div class="column">
        <h4 class="ui top attached block header">报名须知</h4>
        <div class="ui bottom attached segment font-content">
          <%- clazz.reg_info %>
        </div>
      </div>
    </div>
    <% } %>
    <div class="row">
      <div class="column">
        <% if (!reg_open) { %>
        <div class="ui large error message">
          <p>报名将在开课前 15 日开放，请耐心等待。</p>
        </div>
        <% } else { %>
        <form action="<%= syzoj.utils.makeUrl(['class', clazz.id, 'register']) %>" method="post" id="clazz_reg">
          <div class="ui form">
            <% if (clazz.reg_info || hasToken) { %>
            <div class="field">
              <label for="token"><% if (hasToken) { %>邀请码<% } else { %>输入 "AGREE" 以继续<% } %></label>
              <input type="text" name="token">
            </div>
            <% } %>
            <div class="ui basic modal" id="modal-confirm">
              <div class="ui icon header">
                <i class="book icon"></i>
                <p style="margin-top: 15px; ">报名入班</p>
              </div>
              <div class="content" style="text-align: center; ">
                <p>确认报名进入该班级吗？</p>
              </div>
              <div class="actions">
                <div class="ui red basic cancel inverted button">
                  <i class="remove icon"></i>
                  否
                </div>
                <a class="ui green ok inverted button" id="my_submit">
                  <i class="checkmark icon"></i>
                  是
                </a>
                <script>
                $(function () {
                  $('#my_submit').click(function () {
                    $('#clazz_reg').submit();
                  });
                });
                </script>
              </div>
            </div>
            <div style="text-align: center; margin-top: 30px; ">
              <div class="ui labeled icon blue button" onclick="$('#modal-confirm').modal('show')"><i class="ui edit icon"></i>报名</div>
              <a href="<%= syzoj.utils.makeUrl(['course', course.id, 'classes']) %>" class="ui labeled icon button"><i class="ui angle left icon"></i>返回</a>
            </div>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% include footer %>
